#include "include/head.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(rgba16f,binding=0) readonly uniform image2D uPrevious;
layout(rgba16f,binding=1) writeonly uniform image2D uNext;
uniform sampler2D uMask;
// 1.2: the grid follows the camera - its corner in the world, its cell (m), and on a step where the corner moved, how
// many cells the old state is carried by
uniform vec2 uOrigin;
uniform float uCell;
uniform ivec2 uShift;
uniform float uDt,uTime,uRain,uImpulseScale;
uniform int uImpulses;
uniform vec4 uImpulse[32];
vec4 previous(ivec2 p) {
 ivec2 q=p+uShift;
 return any(lessThan(q,ivec2(0))) || any(greaterThanEqual(q,ivec2(256)))?vec4(0):imageLoad(uPrevious,q);
}
float heightAt(ivec2 p,float center) {
 p=clamp(p,ivec2(0),ivec2(255));
 // the shore reflects (a dry cell takes the centre's height), as a pond's edge throws a ring back
 return texelFetch(uMask,p,0).g>0.5?previous(p).r:center;
}
float hash(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
void main() {
 ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,ivec2(256))))return;
 if(texelFetch(uMask,p,0).g<0.5) { imageStore(uNext,p,vec4(0));return; }
 vec4 state=previous(p);float h=state.r,v=state.g;
 vec2 world=uOrigin+(vec2(p)+0.5)*uCell;
 float lap=(heightAt(p+ivec2(1,0),h)+heightAt(p-ivec2(1,0),h)+heightAt(p+ivec2(0,1),h)+heightAt(p-ivec2(0,1),h)-4.0*h)/(uCell*uCell);
 // small ripples on a pond run at about a metre and a quarter a second and die out over a few metres; the speed is
 // held well inside the step's stability bound
 float c=min(1.25,uCell*0.45/uDt);
 v=(v+c*c*lap*uDt)*exp(-1.1*uDt);
 h*=exp(-0.5*uDt);   // and the surface settles back to its level
 for(int i=0;i<min(uImpulses,32);i++) {
  // a tight push where the body meets the surface (a fifth of its reach, 12 to 40 cm): what spreads from it is a set
  // of crisp rings, as water gives - a source the body's whole width wide only raised a broad, smooth swell
  vec4 impulse=uImpulse[i];float d=distance(world,impulse.xy)/clamp(impulse.z*0.25,0.12,0.4);
  // (zero in sum: the push down and the heap round it hold the same water, so no lasting swell is left behind)
  v+=(exp(-d*d*2.0)-0.25*exp(-d*d*0.5))*impulse.w*uImpulseScale*1.2;
 }
 // rain: a drop now and then on open water, each a little ring of its own
 float drop=hash(vec2(p)+floor(uTime*120.0));
 if(drop<uRain*texelFetch(uMask,p,0).b*0.0004)v-=0.35;
 h=clamp(h+v*uDt,-0.14,0.14);
 imageStore(uNext,p,vec4(h,clamp(v,-2.0,2.0),0,0));
}
